(namespace rv64
  (export firmware-machine)

  (func sequential-pc (in (pc-offset (bits 64))) (out (next-offset (bits 64)))
    (def four #x0000000000000004)
    (def next-offset (::rv64::arithmetic::add pc-offset four)))

  ;; 乗算の初期化を1回行い、実回路の最大457段を越える間隔で更新する。
  ;; done は乗算器に残るため、実行中に立ち上がったときだけ完了として扱う。
  (module firmware-multiply
    (in start (left (bits 64)) (right (bits 64)))
    (out (product (bits 64)) finished)
    (def armed (delay-2 1))
    (def initialized (delay-8 start))
    (def running (phase-mode initialized finished))
    (def initialize (nor running running))
    (def no-done (nor done done))
    (def not-yet (execute-and running no-done))
    (def request (delay-512 capture))
    (def repeat (accept-pulse request not-yet))
    (def either (execute-or start repeat))
    (def capture (phase-bit either armed))
    (def (product done) (::rv64::arithmetic::mul-low left right initialize capture))
    (def older-done (delay-2 done))
    (def rising (nor no-done older-done))
    (def finished (accept-pulse rising running)))

  ;; 同じアドレス空間から命令とデータを読む。入力は実行を制御せず、RAM の観測先だけを指定する。
  ;; commit のフレームの PC は完了した命令を指す。次 tick に PC が更新される。
  ;; load または store の間は、その命令がデータポートを使う。
  (module firmware-machine
    (in (probe-address (bits 64)))
    (out (pc-offset (bits 64)) (probe-data (bits 64)) (memory-address (bits 64))
         (register-data (bits 64)) register-enable memory-write commit stopped)
    (def pc-offset (program-counter next-offset commit))
    (def (instruction fetch-valid) (firmware-fetch pc-offset))
    (def (opcode rd funct3 rs1 rs2 funct7 imm-i imm-s imm-b imm-u imm-j)
      (decode instruction))
    (def (first-value second-value ready)
      (instruction-window commit instruction rd register-data register-enable))

    (def (basic-valid basic-next basic-rd basic-data basic-write store-address store-data store)
      (execute-boot instruction pc-offset first-value second-value))
    (def (control control-valid control-next control-rd control-data control-write)
      (execute-control instruction pc-offset first-value second-value))
    (def (load load-valid load-address load-rd) (execute-load instruction first-value))
    (def (logic multiply logic-data) (execute-logic instruction first-value second-value))

    (def observation-or-store (::rv64::arithmetic::select store probe-address store-address))
    (def memory-address (::rv64::arithmetic::select load observation-or-store load-address))
    (def (probe-data readable writable)
      (firmware-data-memory memory-address store-data memory-write))
    (def not-store (nor store store))
    (def store-valid (execute-or not-store writable))
    (def basic-accepted (execute-and basic-valid store-valid))
    (def logic-or-multiply (execute-or logic multiply))
    (def sequential-operation (execute-or load-valid logic-or-multiply))
    (def control-or-basic (execute-or control-valid basic-accepted))
    (def executable (execute-or control-or-basic sequential-operation))
    (def valid (execute-and fetch-valid executable))

    (def next-basic-or-control (::rv64::arithmetic::select control basic-next control-next))
    (def sequential (sequential-pc pc-offset))
    (def next-offset (::rv64::arithmetic::select sequential-operation next-basic-or-control sequential))
    (def data-basic-or-control (::rv64::arithmetic::select control basic-data control-data))
    (def data-or-logic (::rv64::arithmetic::select logic data-basic-or-control logic-data))
    (def data-or-load (::rv64::arithmetic::select load data-or-logic probe-data))
    (def register-data (::rv64::arithmetic::select multiply data-or-load product))
    (def basic-or-control-write (execute-or basic-write control-write))
    (def register-request (execute-or basic-or-control-write sequential-operation))

    (def invalid (nor valid valid))
    (def failure (accept-pulse ready invalid))
    (def stopped (phase-bit 1 failure))
    (def mul-request (execute-and valid multiply))
    (def mul-start (accept-pulse ready mul-request))
    (def (product mul-finished) (firmware-multiply mul-start first-value second-value))
    (def not-multiply (nor multiply multiply))
    (def simple (accept-pulse ready not-multiply))
    (def raw-retire (execute-or simple mul-finished))
    (def armed (delay-2 1))
    (def retire (phase-bit raw-retire armed))
    (def commit (accept-pulse retire valid))
    (def enable-register (execute-and valid register-request))
    (def register-enable (accept-pulse retire enable-register))
    (def enable-memory (execute-and valid store))
    (def memory-write (accept-pulse retire enable-memory))))
