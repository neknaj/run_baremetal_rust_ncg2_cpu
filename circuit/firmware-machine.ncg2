(namespace rv64
  (export firmware-machine)

  ;; 同じアドレス空間から命令とデータを読む。入力は実行を制御せず、RAM の観測先だけを指定する。
  ;; commit のフレームの PC は完了した命令を指す。次 tick に PC が更新される。
  (module firmware-machine
    (in (probe-address (bits 64)))
    (out (pc-offset (bits 64)) (probe-data (bits 64)) (memory-address (bits 64))
         (register-data (bits 64)) register-enable memory-write commit stopped)
    (def pc-offset (program-counter next-offset commit))
    (def (instruction fetch-valid) (firmware-fetch pc-offset))
    (def (probe-data readable writable)
      (firmware-cpu-memory memory-address store-data memory-write))
    (def (issue next-offset memory-address store-data register-data register-enable
          memory-write commit stopped)
      (firmware-engine pc-offset instruction fetch-valid probe-data probe-address))))
