(namespace rv64
  (export execute-subword)

  ;; LB/LBU、自然整列した LH/LHU と SB/SH/SW のデータポート要求を作る。
  ;; word-before はアドレスを含む語の読み出し値。write-data はその語を部分更新した値。
  (func execute-subword
    (in (instruction (bits 32)) (first-value (bits 64)) (second-value (bits 64))
        (word-before (bits 64)))
    (out load load-valid store store-valid (word-address (bits 64))
         (load-data (bits 64)) (write-data (bits 64)))
    (def (opcode rd funct3 rs1 rs2 funct7 immediate-i immediate-s immediate-b immediate-u immediate-j)
      (decode instruction))
    (def op0 (bit opcode 0))
    (def op1 (bit opcode 1))
    (def op-low (slice opcode 2 3))
    (def op5 (bit opcode 5))
    (def op6 (bit opcode 6))
    (def not-0 (nor op0 op0))
    (def not-1 (nor op1 op1))
    (def common (concat not-0 not-1 op-low op6))
    (def memory-op (execute-zero-6 common))
    (def load-op (nor op5 op5))
    (def read-op (execute-and memory-op load-op))
    (def write-op (execute-and memory-op op5))
    (def f0 (bit funct3 0))
    (def f1 (bit funct3 1))
    (def unsigned (bit funct3 2))
    (def byte-or-halfword (nor f1 f1))
    (def load (execute-and read-op byte-or-halfword))

    ;; 加算後の下位3ビットは語の中の位置。同じ語を読み出しと書き戻しに使う。
    (def immediate (::rv64::arithmetic::select write-op immediate-i immediate-s))
    (def address (::rv64::arithmetic::add first-value immediate))
    (def byte-offset (slice address 0 3))
    (def address-upper (slice address 3 61))
    (def zeros #b000)
    (def word-address (concat zeros address-upper))
    (def (readable writable) (firmware-data-access word-address))
    (def (aligned-halfword halfword-data) (::rv64::memory::read-halfword word-before byte-offset unsigned))
    (def byte (nor f0 f0))
    (def aligned-load (execute-or byte aligned-halfword))
    (def usable (execute-and aligned-load readable))
    (def load-valid (execute-and load usable))
    (def byte-data (::rv64::memory::read-byte word-before byte-offset unsigned))
    (def load-data (::rv64::arithmetic::select f0 byte-data halfword-data))
    (def (aligned-store write-data)
      (::rv64::memory::merge-store word-before second-value byte-offset funct3))
    (def store (execute-and write-op aligned-store))
    (def store-valid (execute-and store writable))))
