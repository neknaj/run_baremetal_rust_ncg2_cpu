(namespace rv64::arithmetic
  (export add shift-left select xor compare-unsigned less-than-unsigned)

  ;; a XOR b と、その組の桁上がりを使う1ビットの加算段。
  (func add-bit (in a b carry-in) (out carry-out sum)
    (def neither (nor a b))
    (def only-b (nor a neither))
    (def only-a (nor b neither))
    (def equal (nor only-a only-b))
    (def either (nor equal equal))
    (def first-carry (nor neither either))

    (def neither-second (nor either carry-in))
    (def only-carry (nor either neither-second))
    (def only-either (nor carry-in neither-second))
    (def equal-second (nor only-carry only-either))
    (def sum (nor equal-second equal-second))
    (def second-carry (nor neither-second sum))
    (def no-carry (nor first-carry second-carry))
    (def carry-out (nor no-carry no-carry)))

  ;; select が1なら set、0なら clear を通す。
  (func select-bit (in select clear set) (out result)
    (def not-select (nor select select))
    (def not-set (nor set set))
    (def not-clear (nor clear clear))
    (def selected-set (nor not-select not-set))
    (def selected-clear (nor select not-clear))
    (def neither (nor selected-set selected-clear))
    (def result (nor neither neither)))

  (func add-2
    (in (a (bits 2)) (b (bits 2)) carry-in)
    (out carry-out (sum (bits 2)))
    (def a-low (slice a 0 1))
    (def a-high (slice a 1 1))
    (def b-low (slice b 0 1))
    (def b-high (slice b 1 1))
    (def (carry-middle sum-low) (add-bit a-low b-low carry-in))
    (def (carry-out sum-high) (add-bit a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select-2
    (in select (clear (bits 2)) (set (bits 2)))
    (out (result (bits 2)))
    (def clear-low (slice clear 0 1))
    (def clear-high (slice clear 1 1))
    (def set-low (slice set 0 1))
    (def set-high (slice set 1 1))
    (def low (select-bit select clear-low set-low))
    (def high (select-bit select clear-high set-high))
    (def result (concat low high)))

  (func add-4
    (in (a (bits 4)) (b (bits 4)) carry-in)
    (out carry-out (sum (bits 4)))
    (def a-low (slice a 0 2))
    (def a-high (slice a 2 2))
    (def b-low (slice b 0 2))
    (def b-high (slice b 2 2))
    (def (carry-middle sum-low) (add-2 a-low b-low carry-in))
    (def (carry-out sum-high) (add-2 a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select-4
    (in select (clear (bits 4)) (set (bits 4)))
    (out (result (bits 4)))
    (def clear-low (slice clear 0 2))
    (def clear-high (slice clear 2 2))
    (def set-low (slice set 0 2))
    (def set-high (slice set 2 2))
    (def low (select-2 select clear-low set-low))
    (def high (select-2 select clear-high set-high))
    (def result (concat low high)))

  (func add-8
    (in (a (bits 8)) (b (bits 8)) carry-in)
    (out carry-out (sum (bits 8)))
    (def a-low (slice a 0 4))
    (def a-high (slice a 4 4))
    (def b-low (slice b 0 4))
    (def b-high (slice b 4 4))
    (def (carry-middle sum-low) (add-4 a-low b-low carry-in))
    (def (carry-out sum-high) (add-4 a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select-8
    (in select (clear (bits 8)) (set (bits 8)))
    (out (result (bits 8)))
    (def clear-low (slice clear 0 4))
    (def clear-high (slice clear 4 4))
    (def set-low (slice set 0 4))
    (def set-high (slice set 4 4))
    (def low (select-4 select clear-low set-low))
    (def high (select-4 select clear-high set-high))
    (def result (concat low high)))

  (func add-16
    (in (a (bits 16)) (b (bits 16)) carry-in)
    (out carry-out (sum (bits 16)))
    (def a-low (slice a 0 8))
    (def a-high (slice a 8 8))
    (def b-low (slice b 0 8))
    (def b-high (slice b 8 8))
    (def (carry-middle sum-low) (add-8 a-low b-low carry-in))
    (def (carry-out sum-high) (add-8 a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select-16
    (in select (clear (bits 16)) (set (bits 16)))
    (out (result (bits 16)))
    (def clear-low (slice clear 0 8))
    (def clear-high (slice clear 8 8))
    (def set-low (slice set 0 8))
    (def set-high (slice set 8 8))
    (def low (select-8 select clear-low set-low))
    (def high (select-8 select clear-high set-high))
    (def result (concat low high)))

  (func add-32
    (in (a (bits 32)) (b (bits 32)) carry-in)
    (out carry-out (sum (bits 32)))
    (def a-low (slice a 0 16))
    (def a-high (slice a 16 16))
    (def b-low (slice b 0 16))
    (def b-high (slice b 16 16))
    (def (carry-middle sum-low) (add-16 a-low b-low carry-in))
    (def (carry-out sum-high) (add-16 a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select-32
    (in select (clear (bits 32)) (set (bits 32)))
    (out (result (bits 32)))
    (def clear-low (slice clear 0 16))
    (def clear-high (slice clear 16 16))
    (def set-low (slice set 0 16))
    (def set-high (slice set 16 16))
    (def low (select-16 select clear-low set-low))
    (def high (select-16 select clear-high set-high))
    (def result (concat low high)))

  (func add-64
    (in (a (bits 64)) (b (bits 64)) carry-in)
    (out carry-out (sum (bits 64)))
    (def a-low (slice a 0 32))
    (def a-high (slice a 32 32))
    (def b-low (slice b 0 32))
    (def b-high (slice b 32 32))
    (def (carry-middle sum-low) (add-32 a-low b-low carry-in))
    (def (carry-out sum-high) (add-32 a-high b-high carry-middle))
    (def sum (concat sum-low sum-high)))

  (func select
    (in select (clear (bits 64)) (set (bits 64)))
    (out (result (bits 64)))
    (def clear-low (slice clear 0 32))
    (def clear-high (slice clear 32 32))
    (def set-low (slice set 0 32))
    (def set-high (slice set 32 32))
    (def low (select-32 select clear-low set-low))
    (def high (select-32 select clear-high set-high))
    (def result (concat low high)))

  ;; 低位から桁を渡し、64ビットを越えた桁は捨てる。
  (func add (in (left (bits 64)) (right (bits 64))) (out (result (bits 64)))
    (def (carry-out result) (add-64 left right 0)))

  ;; シフト量のビットごとに 1、2、4、8、16、32 ビットの移動を選ぶ。
  (func shift-left (in (value (bits 64)) (amount (bits 6))) (out (result (bits 64)))
    (def shift-1 (bit amount 0))
    (def zeros-1 #b0)
    (def low-1 (slice value 0 63))
    (def moved-1 (concat zeros-1 low-1))
    (def after-1 (select shift-1 value moved-1))
    (def shift-2 (bit amount 1))
    (def zeros-2 #b00)
    (def low-2 (slice after-1 0 62))
    (def moved-2 (concat zeros-2 low-2))
    (def after-2 (select shift-2 after-1 moved-2))
    (def shift-4 (bit amount 2))
    (def zeros-4 #b0000)
    (def low-4 (slice after-2 0 60))
    (def moved-4 (concat zeros-4 low-4))
    (def after-4 (select shift-4 after-2 moved-4))
    (def shift-8 (bit amount 3))
    (def zeros-8 #b00000000)
    (def low-8 (slice after-4 0 56))
    (def moved-8 (concat zeros-8 low-8))
    (def after-8 (select shift-8 after-4 moved-8))
    (def shift-16 (bit amount 4))
    (def zeros-16 #b0000000000000000)
    (def low-16 (slice after-8 0 48))
    (def moved-16 (concat zeros-16 low-16))
    (def after-16 (select shift-16 after-8 moved-16))
    (def shift-32 (bit amount 5))
    (def zeros-32 #b00000000000000000000000000000000)
    (def low-32 (slice after-16 0 32))
    (def moved-32 (concat zeros-32 low-32))
    (def result (select shift-32 after-16 moved-32))
   )

  (func xor-bit (in left right) (out result)
    (def neither (nor left right))
    (def only-left (nor right neither))
    (def only-right (nor left neither))
    (def equal (nor only-left only-right))
    (def result (nor equal equal)))

  (func xor-2
    (in (left (bits 2)) (right (bits 2)))
    (out (result (bits 2)))
    (def left-low (slice left 0 1))
    (def left-high (slice left 1 1))
    (def right-low (slice right 0 1))
    (def right-high (slice right 1 1))
    (def low (xor-bit left-low right-low))
    (def high (xor-bit left-high right-high))
    (def result (concat low high)))

  (func xor-4
    (in (left (bits 4)) (right (bits 4)))
    (out (result (bits 4)))
    (def left-low (slice left 0 2))
    (def left-high (slice left 2 2))
    (def right-low (slice right 0 2))
    (def right-high (slice right 2 2))
    (def low (xor-2 left-low right-low))
    (def high (xor-2 left-high right-high))
    (def result (concat low high)))

  (func xor-8
    (in (left (bits 8)) (right (bits 8)))
    (out (result (bits 8)))
    (def left-low (slice left 0 4))
    (def left-high (slice left 4 4))
    (def right-low (slice right 0 4))
    (def right-high (slice right 4 4))
    (def low (xor-4 left-low right-low))
    (def high (xor-4 left-high right-high))
    (def result (concat low high)))

  (func xor-16
    (in (left (bits 16)) (right (bits 16)))
    (out (result (bits 16)))
    (def left-low (slice left 0 8))
    (def left-high (slice left 8 8))
    (def right-low (slice right 0 8))
    (def right-high (slice right 8 8))
    (def low (xor-8 left-low right-low))
    (def high (xor-8 left-high right-high))
    (def result (concat low high)))

  (func xor-32
    (in (left (bits 32)) (right (bits 32)))
    (out (result (bits 32)))
    (def left-low (slice left 0 16))
    (def left-high (slice left 16 16))
    (def right-low (slice right 0 16))
    (def right-high (slice right 16 16))
    (def low (xor-16 left-low right-low))
    (def high (xor-16 left-high right-high))
    (def result (concat low high)))

  ;; 対応する入力ビットごとに XOR を計算し、元のビット順で返す。
  (func xor
    (in (left (bits 64)) (right (bits 64)))
    (out (result (bits 64)))
    (def left-low (slice left 0 32))
    (def left-high (slice left 32 32))
    (def right-low (slice right 0 32))
    (def right-high (slice right 32 32))
    (def low (xor-32 left-low right-low))
    (def high (xor-32 left-high right-high))
    (def result (concat low high)))

  (func compare-bit (in left right) (out equal less)
    (def neither (nor left right))
    (def only-left (nor right neither))
    (def less (nor left neither))
    (def equal (nor only-left less)))

  ;; 上位の比較が等しい場合に限り、下位の比較が小なりを決める。
  (func combine-comparison
    (in equal-low less-low equal-high less-high)
    (out equal less)
    (def unequal-low (nor equal-low equal-low))
    (def unequal-high (nor equal-high equal-high))
    (def equal (nor unequal-low unequal-high))
    (def not-less-low (nor less-low less-low))
    (def less-from-low (nor unequal-high not-less-low))
    (def not-less (nor less-high less-from-low))
    (def less (nor not-less not-less)))

  (func compare-2
    (in (left (bits 2)) (right (bits 2)))
    (out equal less)
    (def left-low (slice left 0 1))
    (def left-high (slice left 1 1))
    (def right-low (slice right 0 1))
    (def right-high (slice right 1 1))
    (def (equal-low less-low) (compare-bit left-low right-low))
    (def (equal-high less-high) (compare-bit left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  (func compare-4
    (in (left (bits 4)) (right (bits 4)))
    (out equal less)
    (def left-low (slice left 0 2))
    (def left-high (slice left 2 2))
    (def right-low (slice right 0 2))
    (def right-high (slice right 2 2))
    (def (equal-low less-low) (compare-2 left-low right-low))
    (def (equal-high less-high) (compare-2 left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  (func compare-8
    (in (left (bits 8)) (right (bits 8)))
    (out equal less)
    (def left-low (slice left 0 4))
    (def left-high (slice left 4 4))
    (def right-low (slice right 0 4))
    (def right-high (slice right 4 4))
    (def (equal-low less-low) (compare-4 left-low right-low))
    (def (equal-high less-high) (compare-4 left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  (func compare-16
    (in (left (bits 16)) (right (bits 16)))
    (out equal less)
    (def left-low (slice left 0 8))
    (def left-high (slice left 8 8))
    (def right-low (slice right 0 8))
    (def right-high (slice right 8 8))
    (def (equal-low less-low) (compare-8 left-low right-low))
    (def (equal-high less-high) (compare-8 left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  (func compare-32
    (in (left (bits 32)) (right (bits 32)))
    (out equal less)
    (def left-low (slice left 0 16))
    (def left-high (slice left 16 16))
    (def right-low (slice right 0 16))
    (def right-high (slice right 16 16))
    (def (equal-low less-low) (compare-16 left-low right-low))
    (def (equal-high less-high) (compare-16 left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  ;; 二つの64ビット値を符号なしで比較し、等値、小なりの順に返す。
  (func compare-unsigned
    (in (left (bits 64)) (right (bits 64)))
    (out equal less)
    (def left-low (slice left 0 32))
    (def left-high (slice left 32 32))
    (def right-low (slice right 0 32))
    (def right-high (slice right 32 32))
    (def (equal-low less-low) (compare-32 left-low right-low))
    (def (equal-high less-high) (compare-32 left-high right-high))
    (def (equal less) (combine-comparison equal-low less-low equal-high less-high)))

  ;; 左の値が右の値より小さい場合に1を返す。
  (func less-than-unsigned
    (in (left (bits 64)) (right (bits 64)))
    (out less)
    (def (equal less) (compare-unsigned left right))))
