(namespace rv64::memory
  (export read-byte read-halfword merge-store)

  (func select-bit (in choose clear set) (out result)
    (def not-choose (nor choose choose))
    (def not-clear (nor clear clear))
    (def not-set (nor set set))
    (def left (nor choose not-clear))
    (def right (nor not-choose not-set))
    (def neither (nor left right))
    (def result (nor neither neither)))

  (func select-byte
    (in choose (clear (bits 8)) (set (bits 8)))
    (out (result (bits 8)))
    (def a0 (bit clear 0))
    (def a1 (bit clear 1))
    (def a2 (bit clear 2))
    (def a3 (bit clear 3))
    (def a4 (bit clear 4))
    (def a5 (bit clear 5))
    (def a6 (bit clear 6))
    (def a7 (bit clear 7))
    (def b0 (bit set 0))
    (def b1 (bit set 1))
    (def b2 (bit set 2))
    (def b3 (bit set 3))
    (def b4 (bit set 4))
    (def b5 (bit set 5))
    (def b6 (bit set 6))
    (def b7 (bit set 7))
    (def q0 (select-bit choose a0 b0))
    (def q1 (select-bit choose a1 b1))
    (def q2 (select-bit choose a2 b2))
    (def q3 (select-bit choose a3 b3))
    (def q4 (select-bit choose a4 b4))
    (def q5 (select-bit choose a5 b5))
    (def q6 (select-bit choose a6 b6))
    (def q7 (select-bit choose a7 b7))
    (def result (concat q0 q1 q2 q3 q4 q5 q6 q7)))

  ;; オフセット0は語の下位バイトを指す。unsigned が0ならバイトの符号を拡張する。
  (func read-byte
    (in (word (bits 64)) (byte-offset (bits 3)) unsigned)
    (out (value (bits 64)))
    (def lo (bit byte-offset 0))
    (def mid (bit byte-offset 1))
    (def hi (bit byte-offset 2))
    (def lane-0 (slice word 0 8))
    (def lane-1 (slice word 8 8))
    (def lane-2 (slice word 16 8))
    (def lane-3 (slice word 24 8))
    (def lane-4 (slice word 32 8))
    (def lane-5 (slice word 40 8))
    (def lane-6 (slice word 48 8))
    (def lane-7 (slice word 56 8))
    (def pair-0 (select-byte lo lane-0 lane-1))
    (def pair-1 (select-byte lo lane-2 lane-3))
    (def pair-2 (select-byte lo lane-4 lane-5))
    (def pair-3 (select-byte lo lane-6 lane-7))
    (def half-0 (select-byte mid pair-0 pair-1))
    (def half-1 (select-byte mid pair-2 pair-3))
    (def chosen (select-byte hi half-0 half-1))
    (def high-bit (bit chosen 7))
    (def nonnegative (nor high-bit high-bit))
    (def extension (nor unsigned nonnegative))
    (def fill-2 (concat extension extension))
    (def fill-4 (concat fill-2 fill-2))
    (def fill-8 (concat fill-4 fill-4))
    (def fill-16 (concat fill-8 fill-8))
    (def fill-32 (concat fill-16 fill-16))
    (def value (concat chosen fill-8 fill-16 fill-32)))

  (func select-halfword
    (in choose (clear (bits 16)) (set (bits 16)))
    (out (value (bits 16)))
    (def clear-low (slice clear 0 8))
    (def clear-high (slice clear 8 8))
    (def set-low (slice set 0 8))
    (def set-high (slice set 8 8))
    (def low (select-byte choose clear-low set-low))
    (def high (select-byte choose clear-high set-high))
    (def value (concat low high)))

  ;; 自然整列した16ビットを選び、unsigned が0なら符号拡張する。
  ;; aligned が0のときは value を使わない。
  (func read-halfword
    (in (word (bits 64)) (byte-offset (bits 3)) unsigned)
    (out aligned (value (bits 64)))
    (def odd (bit byte-offset 0))
    (def aligned (nor odd odd))
    (def mid (bit byte-offset 1))
    (def hi (bit byte-offset 2))
    (def lane-0 (slice word 0 16))
    (def lane-1 (slice word 16 16))
    (def lane-2 (slice word 32 16))
    (def lane-3 (slice word 48 16))
    (def pair-0 (select-halfword mid lane-0 lane-1))
    (def pair-1 (select-halfword mid lane-2 lane-3))
    (def chosen (select-halfword hi pair-0 pair-1))
    (def sign (bit chosen 15))
    (def nonnegative (nor sign sign))
    (def extension (nor unsigned nonnegative))
    (def fill-2 (concat extension extension))
    (def fill-4 (concat fill-2 fill-2))
    (def fill-8 (concat fill-4 fill-4))
    (def fill-16 (concat fill-8 fill-8))
    (def fill-32 (concat fill-16 fill-16))
    (def value (concat chosen fill-16 fill-32)))

  ;; データを語内のバイト位置に合わせて左へずらす。下位の空いたビットには0を入れる。
  (func align-store-value
    (in (value (bits 64)) lo mid hi)
    (out (aligned (bits 64)))
    (def zero-8 #x00)
    (def low-56 (slice value 0 56))
    (def shift-8 (concat zero-8 low-56))
    (def after-8 (::rv64::arithmetic::select lo value shift-8))
    (def zero-16 #x0000)
    (def low-48 (slice after-8 0 48))
    (def shift-16 (concat zero-16 low-48))
    (def after-16 (::rv64::arithmetic::select mid after-8 shift-16))
    (def zero-32 #x00000000)
    (def low-32 (slice after-16 0 32))
    (def shift-32 (concat zero-32 low-32))
    (def aligned (::rv64::arithmetic::select hi after-16 shift-32)))

  ;; マスクの1ビットが語の1バイトに対応する。
  (func align-store-mask
    (in (mask (bits 8)) lo mid hi)
    (out (aligned (bits 8)))
    (def low-7 (slice mask 0 7))
    (def shift-1 (concat 0 low-7))
    (def after-1 (select-byte lo mask shift-1))
    (def low-6 (slice after-1 0 6))
    (def zero-2 #b00)
    (def shift-2 (concat zero-2 low-6))
    (def after-2 (select-byte mid after-1 shift-2))
    (def low-4 (slice after-2 0 4))
    (def zero-4 #b0000)
    (def shift-4 (concat zero-4 low-4))
    (def aligned (select-byte hi after-2 shift-4)))

  ;; SB、SH、SW の funct3 と語内の自然整列を検査する。
  ;; 成功時は該当する下位1、2、4バイトだけを元の語に重ねる。
  ;; 無効なら valid は0で、updated-word に元の語を返す。
  (func merge-store
    (in (word (bits 64)) (value (bits 64)) (byte-offset (bits 3)) (funct3 (bits 3)))
    (out valid (updated-word (bits 64)))
    (def f0 (bit funct3 0))
    (def f1 (bit funct3 1))
    (def f2 (bit funct3 2))
    (def lo (bit byte-offset 0))
    (def mid (bit byte-offset 1))
    (def hi (bit byte-offset 2))
    (def upper-pair-clear (nor f1 f2))
    (def lower-pair-clear (nor f0 f2))
    (def unsupported-width (nor upper-pair-clear lower-pair-clear))
    (def align-half (nor lo lo))
    (def align-word (nor lo mid))
    (def align-byte-or-half (select-bit f0 1 align-half))
    (def aligned (select-bit f1 align-byte-or-half align-word))
    (def not-aligned (nor aligned aligned))
    (def valid (nor unsupported-width not-aligned))

    (def byte-mask #x01)
    (def half-mask #x03)
    (def word-mask #x0f)
    (def short-mask (select-byte f0 byte-mask half-mask))
    (def size-mask (select-byte f1 short-mask word-mask))
    (def mask (align-store-mask size-mask lo mid hi))
    (def moved (align-store-value value lo mid hi))
    (def mask-0 (bit mask 0))
    (def mask-1 (bit mask 1))
    (def mask-2 (bit mask 2))
    (def mask-3 (bit mask 3))
    (def mask-4 (bit mask 4))
    (def mask-5 (bit mask 5))
    (def mask-6 (bit mask 6))
    (def mask-7 (bit mask 7))
    (def write-0 (select-bit valid 0 mask-0))
    (def write-1 (select-bit valid 0 mask-1))
    (def write-2 (select-bit valid 0 mask-2))
    (def write-3 (select-bit valid 0 mask-3))
    (def write-4 (select-bit valid 0 mask-4))
    (def write-5 (select-bit valid 0 mask-5))
    (def write-6 (select-bit valid 0 mask-6))
    (def write-7 (select-bit valid 0 mask-7))
    (def old-0 (slice word 0 8))
    (def old-1 (slice word 8 8))
    (def old-2 (slice word 16 8))
    (def old-3 (slice word 24 8))
    (def old-4 (slice word 32 8))
    (def old-5 (slice word 40 8))
    (def old-6 (slice word 48 8))
    (def old-7 (slice word 56 8))
    (def new-0 (slice moved 0 8))
    (def new-1 (slice moved 8 8))
    (def new-2 (slice moved 16 8))
    (def new-3 (slice moved 24 8))
    (def new-4 (slice moved 32 8))
    (def new-5 (slice moved 40 8))
    (def new-6 (slice moved 48 8))
    (def new-7 (slice moved 56 8))
    (def lane-0 (select-byte write-0 old-0 new-0))
    (def lane-1 (select-byte write-1 old-1 new-1))
    (def lane-2 (select-byte write-2 old-2 new-2))
    (def lane-3 (select-byte write-3 old-3 new-3))
    (def lane-4 (select-byte write-4 old-4 new-4))
    (def lane-5 (select-byte write-5 old-5 new-5))
    (def lane-6 (select-byte write-6 old-6 new-6))
    (def lane-7 (select-byte write-7 old-7 new-7))
    (def updated-word (concat lane-0 lane-1 lane-2 lane-3 lane-4 lane-5 lane-6 lane-7))))
