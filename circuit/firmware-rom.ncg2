(namespace rv64
  (export firmware-rom)

  ;; 起動 ELF の初期化済みデータを、下位バイトから並べた64ビット語で読む。
  ;; tools/elf_image.py --format ncg2-rom で更新する。
  (func firmware-rom (in (word-index (bits 5))) (out (word (bits 64)))
    (def select-0 (bit word-index 0))
    (def select-1 (bit word-index 1))
    (def select-2 (bit word-index 2))
    (def select-3 (bit word-index 3))
    (def select-4 (bit word-index 4))
    (def word-0 #x8001819300002197)
    (def word-1 #xfe81011300020117)
    (def word-2 #xff02829300001297)
    (def word-3 #xff03031300001317)
    (def word-4 #x0002b0230062f863)
    (def word-5 #xff5ff06f00828293)
    (def word-6 #x00f4d2b7ff010113)
    (def word-7 #x00d29293a1928293)
    (def word-8 #x00e29293a4728293)
    (def word-9 #x00c29293d3528293)
    (def word-10 #x0051342382f28293)
    (def word-11 #x00c000ef00813503)
    (def word-12 #x0000006f01010113)
    (def word-13 #x0000061700000597)
    (def word-14 #x074636030705b583)
    (def word-15 #x0000061702b605b3)
    (def word-16 #x0546370300001697)
    (def word-17 #x00e51863f806b603)
    (def word-18 #x0030051300060a63)
    (def word-19 #x005005130240006f)
    (def word-20 #x0050051301c0006f)
    (def word-21 #x0035051302051513)
    (def word-22 #x00a0353300a5c533)
    (def word-23 #x0002061700150513)
    (def word-24 #x00b63423f3460613)
    (def word-25 #x0000806700a63023)
    (def word-26 #x7a650c691bd3482f)
    (def word-27 #x0000000100000001)
    (def word-28 #x0000000200000003)
    (def word-29 #x0000000000000000)
    (def word-30 #x0000000000000000)
    (def word-31 #x0000000000000000)
    (def selected-0-0 (::rv64::arithmetic::select select-0 word-0 word-1))
    (def selected-0-1 (::rv64::arithmetic::select select-0 word-2 word-3))
    (def selected-0-2 (::rv64::arithmetic::select select-0 word-4 word-5))
    (def selected-0-3 (::rv64::arithmetic::select select-0 word-6 word-7))
    (def selected-0-4 (::rv64::arithmetic::select select-0 word-8 word-9))
    (def selected-0-5 (::rv64::arithmetic::select select-0 word-10 word-11))
    (def selected-0-6 (::rv64::arithmetic::select select-0 word-12 word-13))
    (def selected-0-7 (::rv64::arithmetic::select select-0 word-14 word-15))
    (def selected-0-8 (::rv64::arithmetic::select select-0 word-16 word-17))
    (def selected-0-9 (::rv64::arithmetic::select select-0 word-18 word-19))
    (def selected-0-10 (::rv64::arithmetic::select select-0 word-20 word-21))
    (def selected-0-11 (::rv64::arithmetic::select select-0 word-22 word-23))
    (def selected-0-12 (::rv64::arithmetic::select select-0 word-24 word-25))
    (def selected-0-13 (::rv64::arithmetic::select select-0 word-26 word-27))
    (def selected-0-14 (::rv64::arithmetic::select select-0 word-28 word-29))
    (def selected-0-15 (::rv64::arithmetic::select select-0 word-30 word-31))
    (def selected-1-0 (::rv64::arithmetic::select select-1 selected-0-0 selected-0-1))
    (def selected-1-1 (::rv64::arithmetic::select select-1 selected-0-2 selected-0-3))
    (def selected-1-2 (::rv64::arithmetic::select select-1 selected-0-4 selected-0-5))
    (def selected-1-3 (::rv64::arithmetic::select select-1 selected-0-6 selected-0-7))
    (def selected-1-4 (::rv64::arithmetic::select select-1 selected-0-8 selected-0-9))
    (def selected-1-5 (::rv64::arithmetic::select select-1 selected-0-10 selected-0-11))
    (def selected-1-6 (::rv64::arithmetic::select select-1 selected-0-12 selected-0-13))
    (def selected-1-7 (::rv64::arithmetic::select select-1 selected-0-14 selected-0-15))
    (def selected-2-0 (::rv64::arithmetic::select select-2 selected-1-0 selected-1-1))
    (def selected-2-1 (::rv64::arithmetic::select select-2 selected-1-2 selected-1-3))
    (def selected-2-2 (::rv64::arithmetic::select select-2 selected-1-4 selected-1-5))
    (def selected-2-3 (::rv64::arithmetic::select select-2 selected-1-6 selected-1-7))
    (def selected-3-0 (::rv64::arithmetic::select select-3 selected-2-0 selected-2-1))
    (def selected-3-1 (::rv64::arithmetic::select select-3 selected-2-2 selected-2-3))
    (def word (::rv64::arithmetic::select select-4 selected-3-0 selected-3-1))))
