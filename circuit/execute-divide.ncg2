(namespace rv64
  (export execute-divide)

  ;; DIV・REM 系の命令を選び、符号、演算幅、商と余りのどちらを書くかを返す。
  ;; 対象外の命令では判別結果と3つの指定をすべて0にする。
  (func execute-divide
    (in (instruction (bits 32)))
    (out recognized signed-mode word-mode remainder-mode)
    (def (opcode rd funct3 rs1 rs2 funct7 imm-i imm-s imm-b imm-u imm-j)
      (decode instruction))

    ;; OP と OP-32 の違いはビット3だけ。ほかのビットを共通の符号化と照合する。
    (def op0 (bit opcode 0))
    (def op1 (bit opcode 1))
    (def op2 (bit opcode 2))
    (def op3 (bit opcode 3))
    (def op4 (bit opcode 4))
    (def op5 (bit opcode 5))
    (def op6 (bit opcode 6))
    (def not-op0 (nor op0 op0))
    (def not-op1 (nor op1 op1))
    (def not-op4 (nor op4 op4))
    (def not-op5 (nor op5 op5))
    (def opcode-difference (concat not-op0 not-op1 op2 not-op4 not-op5 op6))
    (def opcode-matches (execute-zero-6 opcode-difference))

    ;; funct7=1 は M 拡張の演算。funct3 の最上位ビットで乗算と除算を区別する。
    (def low-funct7 (bit funct7 0))
    (def high-funct7 (slice funct7 1 6))
    (def not-low-funct7 (nor low-funct7 low-funct7))
    (def funct7-difference (concat not-low-funct7 high-funct7))
    (def m-operation (execute-zero-7 funct7-difference))
    (def divide (bit funct3 2))
    (def divide-operation (execute-and m-operation divide))
    (def recognized (execute-and opcode-matches divide-operation))

    (def unsigned (bit funct3 0))
    (def signed (nor unsigned unsigned))
    (def choose-remainder (bit funct3 1))
    (def signed-mode (execute-and recognized signed))
    (def word-mode (execute-and recognized op3))
    (def remainder-mode (execute-and recognized choose-remainder))))
