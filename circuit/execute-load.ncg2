(namespace rv64
  (export execute-load)

  ;; rs1-value はデコーダが指すレジスタの読出し値とする。
  ;; is-ld は命令の符号化、valid はその命令で実際に読み出せることを示す。
  ;; address と register-index は命令の有効性にかかわらず求める。
  ;; x0 宛てでもアドレスを検査し、レジスタへの書き戻しの抑止は後段で行う。
  (func execute-load
    (in (instruction (bits 32)) (rs1-value (bits 64)))
    (out is-ld valid (address (bits 64)) (register-index (bits 5)))
    (def (opcode register-index funct3 rs1-index rs2-index funct7
          immediate-i immediate-s immediate-b immediate-u immediate-j)
      (decode instruction))

    ;; opcode 0x03 と funct3 0b011 の指定ビットを反転し、全ビットの一致を調べる。
    (def op0 (bit opcode 0))
    (def op1 (bit opcode 1))
    (def op-rest (slice opcode 2 5))
    (def not-op0 (nor op0 op0))
    (def not-op1 (nor op1 op1))
    (def opcode-difference (concat not-op0 not-op1 op-rest))
    (def is-load-opcode (execute-zero-7 opcode-difference))
    (def funct-low (bit funct3 0))
    (def funct-middle (bit funct3 1))
    (def funct-high (bit funct3 2))
    (def not-funct-low (nor funct-low funct-low))
    (def not-funct-middle (nor funct-middle funct-middle))
    (def function-difference (concat not-funct-low not-funct-middle funct-high))
    (def is-doubleword (execute-zero-3 function-difference))
    (def is-ld (execute-and is-load-opcode is-doubleword))

    ;; 加算器は64ビットを越えた桁を捨てる。メモリマップは8バイト整列も検査する。
    (def address (::rv64::arithmetic::add rs1-value immediate-i))
    (def (readable writable) (firmware-data-access address))
    (def valid (execute-and is-ld readable))))
