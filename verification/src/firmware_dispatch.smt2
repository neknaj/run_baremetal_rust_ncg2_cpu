; RV64 の符号化と更新条件を、回路の内部名に依存せず記述する。
(define-fun op () (_ BitVec 7) ((_ extract 6 0) instruction))
(define-fun funct3 () (_ BitVec 3) ((_ extract 14 12) instruction))
(define-fun funct7 () (_ BitVec 7) ((_ extract 31 25) instruction))
(define-fun immediate-i () (_ BitVec 64)
  ((_ sign_extend 52) ((_ extract 31 20) instruction)))
(define-fun immediate-s () (_ BitVec 64)
  ((_ sign_extend 52) (concat ((_ extract 31 25) instruction) ((_ extract 11 7) instruction))))
(define-fun immediate-b () (_ BitVec 64)
  ((_ sign_extend 51) (concat ((_ extract 31 31) instruction)
                             ((_ extract 7 7) instruction)
                             ((_ extract 30 25) instruction)
                             ((_ extract 11 8) instruction) #b0)))
(define-fun immediate-u () (_ BitVec 64)
  ((_ sign_extend 32) (concat ((_ extract 31 12) instruction) #x000)))
(define-fun immediate-j () (_ BitVec 64)
  ((_ sign_extend 43) (concat ((_ extract 31 31) instruction)
                             ((_ extract 19 12) instruction)
                             ((_ extract 20 20) instruction)
                             ((_ extract 30 21) instruction) #b0)))

(define-fun addi () Bool (and (= op #b0010011) (= funct3 #b000)))
(define-fun slli () Bool (and (= op #b0010011) (= funct3 #b001)
                            (= ((_ extract 31 26) instruction) #b000000)))
(define-fun lui () Bool (= op #b0110111))
(define-fun auipc () Bool (= op #b0010111))
(define-fun jal () Bool (= op #b1101111))
(define-fun jalr () Bool (and (= op #b1100111) (= funct3 #b000)))
(define-fun branch () Bool
  (and (= op #b1100011)
       (or (= funct3 #b000) (= funct3 #b001) (= funct3 #b100)
           (= funct3 #b101) (= funct3 #b110) (= funct3 #b111))))
(define-fun take-branch () Bool
  (and branch
       (or (and (= funct3 #b000) (= rs1 rs2))
           (and (= funct3 #b001) (distinct rs1 rs2))
           (and (= funct3 #b100) (bvslt rs1 rs2))
           (and (= funct3 #b101) (bvsge rs1 rs2))
           (and (= funct3 #b110) (bvult rs1 rs2))
           (and (= funct3 #b111) (bvuge rs1 rs2)))))
(define-fun ld () Bool (and (= op #b0000011) (= funct3 #b011)))
(define-fun sd () Bool (and (= op #b0100011) (= funct3 #b011)))
(define-fun lb () Bool (and (= op #b0000011) (= funct3 #b000)))
(define-fun lbu () Bool (and (= op #b0000011) (= funct3 #b100)))
(define-fun lh () Bool (and (= op #b0000011) (= funct3 #b001)))
(define-fun lhu () Bool (and (= op #b0000011) (= funct3 #b101)))
(define-fun sb () Bool (and (= op #b0100011) (= funct3 #b000)))
(define-fun sh () Bool (and (= op #b0100011) (= funct3 #b001)))
(define-fun sw () Bool (and (= op #b0100011) (= funct3 #b010)))
(define-fun op-xor () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b100)))
(define-fun sltu () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b011)))
(define-fun mulhu () Bool (and (= op #b0110011) (= funct7 #b0000001) (= funct3 #b011)))
(define-fun mul () Bool
  (and (= op #b0110011) (= funct7 #b0000001) (or (= funct3 #b000) (= funct3 #b011))))
(define-fun add () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b000)))
(define-fun sub () Bool (and (= op #b0110011) (= funct7 #b0100000) (= funct3 #b000)))
(define-fun and-register () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b111)))
(define-fun or-register () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b110)))
(define-fun srl () Bool (and (= op #b0110011) (= funct7 #b0000000) (= funct3 #b101)))
(define-fun andi () Bool (and (= op #b0010011) (= funct3 #b111)))
(define-fun xori () Bool (and (= op #b0010011) (= funct3 #b100)))
(define-fun sltiu () Bool (and (= op #b0010011) (= funct3 #b011)))
(define-fun srli () Bool (and (= op #b0010011) (= funct3 #b101)
                           (= ((_ extract 31 26) instruction) #b000000)))
(define-fun srai () Bool (and (= op #b0010011) (= funct3 #b101)
                           (= ((_ extract 31 26) instruction) #b010000)))
(define-fun extended-alu () Bool (or add sub and-register or-register srl andi xori sltiu srli srai))
(define-fun immediate-shift () (_ BitVec 64) ((_ zero_extend 58) ((_ extract 25 20) instruction)))
(define-fun register-shift () (_ BitVec 64) ((_ zero_extend 58) ((_ extract 5 0) rs2)))

(define-fun in-range ((at (_ BitVec 64)) (first (_ BitVec 64)) (end (_ BitVec 64))) Bool
  (and (bvuge at first) (bvult at end)))
(define-fun ram ((at (_ BitVec 64))) Bool
  (ite core-profile
    (or (in-range at #x0000000000016000 #x0000000000019000)
        (in-range at #x000000000002bf00 #x0000000000030000))
    (or (in-range at #x0000000000011000 #x0000000000012000)
        (in-range at #x000000000002c000 #x0000000000030000))))
(define-fun aligned-word ((at (_ BitVec 64))) Bool
  (= (bvurem at (_ bv8 64)) (_ bv0 64)))
(define-fun sum-i () (_ BitVec 64) (bvadd rs1 immediate-i))
(define-fun store-address () (_ BitVec 64) (bvadd rs1 immediate-s))
(define-fun selected-store () Bool (and sd (aligned-word store-address)))
(define-fun word-address ((address (_ BitVec 64))) (_ BitVec 64)
  (bvand address #xfffffffffffffff8))
(define-fun load-byte () Bool (or lb lbu))
(define-fun load-halfword () Bool (or lh lhu))
(define-fun load-small () Bool (or load-byte load-halfword))
(define-fun selected-partial () Bool (or sb
    (and sh (= (bvurem store-address (_ bv2 64)) (_ bv0 64)))
    (and sw (= (bvurem store-address (_ bv4 64)) (_ bv0 64)))))
(define-fun readable ((address (_ BitVec 64))) Bool
  (or (ram address)
      (in-range address #x0000000000010000
        (ite core-profile #x0000000000016000 #x0000000000010100))))
(define-fun load-ok () Bool
  (or (and ld (aligned-word sum-i) (readable sum-i))
      (and load-small (readable (word-address sum-i))
           (or load-byte (= (bvurem sum-i (_ bv2 64)) (_ bv0 64))))))
(define-fun store-ok () Bool
  (or (and selected-store (ram store-address))
      (and selected-partial (ram (word-address store-address)))))
(define-fun memory-address-expected () (_ BitVec 64)
  (ite ld sum-i
    (ite load-small (word-address sum-i)
      (ite selected-store store-address
        (ite selected-partial (word-address store-address) probe)))))
(define-fun byte-shift ((address (_ BitVec 64))) (_ BitVec 64)
  (bvmul (bvurem address (_ bv8 64)) (_ bv8 64)))
(define-fun read-byte () (_ BitVec 8)
  ((_ extract 7 0) (bvlshr loaded-data (byte-shift sum-i))))
(define-fun read-halfword () (_ BitVec 16)
  ((_ extract 15 0) (bvlshr loaded-data (byte-shift sum-i))))
(define-fun low-mask () (_ BitVec 64)
  (ite sb #x00000000000000ff (ite sh #x000000000000ffff #x00000000ffffffff)))
(define-fun partial-mask () (_ BitVec 64)
  (bvshl low-mask (byte-shift store-address)))
(define-fun merged () (_ BitVec 64)
  (bvor (bvand loaded-data (bvnot partial-mask))
        (bvshl (bvand rs2 low-mask) (byte-shift store-address))))

(define-fun absolute-pc () (_ BitVec 64) (bvadd pc (_ bv65536 64)))
(define-fun jump-offset () (_ BitVec 64)
  (ite jal (bvadd pc immediate-j)
    (ite jalr (bvsub (bvand sum-i #xfffffffffffffffe) (_ bv65536 64))
              (bvadd pc immediate-b))))
(define-fun jump () Bool (or jal jalr take-branch))
(define-fun jump-ok () Bool
  (or (not jump) (= (bvurem jump-offset (_ bv4 64)) (_ bv0 64))))
(define-fun supports-register-write () Bool
  (or addi slli lui auipc jal jalr load-ok op-xor sltu mul extended-alu))
(define-fun supported () Bool (or supports-register-write branch store-ok))
(define-fun valid-expected () Bool (and fetch-valid supported jump-ok))
(define-fun register-write-expected () Bool (and valid-expected supports-register-write))
(define-fun memory-write-expected () Bool (and valid-expected store-ok))
(define-fun next-pc-expected () (_ BitVec 64)
  (ite valid-expected (ite jump jump-offset (bvadd pc (_ bv4 64))) pc))

; 書き込み要求は全入力で比較し、レジスタ値は要求が立つ場合に比較する。
(assert (or (distinct valid valid-expected)
            (distinct multiply mul)
            (distinct high-product mulhu)
            (distinct next-pc next-pc-expected)
            (distinct destination ((_ extract 11 7) instruction))
            (distinct register-write register-write-expected)
            (distinct memory-write memory-write-expected)
            (distinct memory-address memory-address-expected)
            (and memory-write-expected
                 (distinct store-data (ite selected-partial merged rs2)))
            (and register-write-expected
                 (or (and addi (distinct register-data sum-i))
                     (and slli (distinct register-data
                       (bvshl rs1 ((_ zero_extend 58) ((_ extract 25 20) instruction)))))
                     (and lui (distinct register-data immediate-u))
                     (and auipc (distinct register-data (bvadd absolute-pc immediate-u)))
                     (and (or jal jalr) (distinct register-data (bvadd absolute-pc (_ bv4 64))))
                     (and ld (distinct register-data loaded-data))
                     (and lb (distinct register-data ((_ sign_extend 56) read-byte)))
                     (and lbu (distinct register-data ((_ zero_extend 56) read-byte)))
                     (and lh (distinct register-data ((_ sign_extend 48) read-halfword)))
                     (and lhu (distinct register-data ((_ zero_extend 48) read-halfword)))
                     (and op-xor (distinct register-data (bvxor rs1 rs2)))
                     (and sltu (distinct register-data
                       (ite (bvult rs1 rs2) (_ bv1 64) (_ bv0 64))))
                     (and add (distinct register-data (bvadd rs1 rs2)))
                     (and sub (distinct register-data (bvsub rs1 rs2)))
                     (and and-register (distinct register-data (bvand rs1 rs2)))
                     (and or-register (distinct register-data (bvor rs1 rs2)))
                     (and srl (distinct register-data (bvlshr rs1 register-shift)))
                     (and andi (distinct register-data (bvand rs1 immediate-i)))
                     (and xori (distinct register-data (bvxor rs1 immediate-i)))
                     (and sltiu (distinct register-data
                       (ite (bvult rs1 immediate-i) (_ bv1 64) (_ bv0 64))))
                     (and srli (distinct register-data (bvlshr rs1 immediate-shift)))
                     (and srai (distinct register-data (bvashr rs1 immediate-shift)))
                     (and mul (distinct register-data product))))))
