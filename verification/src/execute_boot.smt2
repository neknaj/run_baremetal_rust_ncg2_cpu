; RV64I の命令ビットから即値と選択条件を定義する。
(define-fun opcode () (_ BitVec 7) ((_ extract 6 0) instruction))
(define-fun funct3 () (_ BitVec 3) ((_ extract 14 12) instruction))
(define-fun rd () (_ BitVec 5) ((_ extract 11 7) instruction))
(define-fun immediate-i () (_ BitVec 64)
  ((_ sign_extend 52) ((_ extract 31 20) instruction)))
(define-fun immediate-s () (_ BitVec 64)
  ((_ sign_extend 52) (concat ((_ extract 31 25) instruction)
                             ((_ extract 11 7) instruction))))
(define-fun immediate-u () (_ BitVec 64)
  ((_ sign_extend 32) (concat ((_ extract 31 12) instruction) #x000)))
(define-fun immediate-j () (_ BitVec 64)
  ((_ sign_extend 43) (concat ((_ extract 31 31) instruction)
                             ((_ extract 19 12) instruction)
                             ((_ extract 20 20) instruction)
                             ((_ extract 30 21) instruction) #b0)))

(define-fun store-target () (_ BitVec 64) (bvadd rs1 immediate-s))
(define-fun jump-target () (_ BitVec 64) (bvadd pc immediate-j))
(define-fun addi () Bool (and (= opcode (_ bv19 7)) (= funct3 #b000)))
(define-fun slli () Bool (and (= opcode (_ bv19 7)) (= funct3 #b001)
                            (= ((_ extract 31 26) instruction) #b000000)))
(define-fun lui () Bool (= opcode (_ bv55 7)))
(define-fun sd () Bool (and (= opcode (_ bv35 7)) (= funct3 #b011)
                          (= (bvurem store-target (_ bv8 64)) (_ bv0 64))))
(define-fun jal () Bool (and (= opcode (_ bv111 7))
                           (= (bvurem jump-target (_ bv4 64)) (_ bv0 64))))
(define-fun writes-register () Bool (or addi slli lui jal))
(define-fun supported () Bool (or writes-register sd))
(define-fun expected-pc () (_ BitVec 64)
  (ite jal jump-target (ite supported (bvadd pc (_ bv4 64)) pc)))

; 許可ビットが立つ場合だけ、その書き込みの対象と値を比較する。
(assert (or (distinct valid supported)
            (distinct next-pc expected-pc)
            (distinct register-write writes-register)
            (and writes-register (distinct register-index rd))
            (and addi (distinct register-data (bvadd rs1 immediate-i)))
            (and slli (distinct register-data
              (bvshl rs1 ((_ zero_extend 58) ((_ extract 25 20) instruction)))))
            (and lui (distinct register-data immediate-u))
            (and jal (distinct register-data (bvadd pc #x0000000000010004)))
            (distinct store-write sd)
            (and sd (or (distinct store-address store-target) (distinct store-data rs2)))))
