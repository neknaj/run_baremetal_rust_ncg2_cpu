(namespace rv64
  (export uart-entry-fixture)
  (memory uart-entry-ram (address 2) (data (bits 64)))

  ;; 先頭の4語だけを実 RAM に置き、UART 語レジスタをテスト入力に接続する。
  (func uart-test-map (in (address (bits 64))) (out app status data ack)
    (def app-tag (slice address 5 59))
    (def aligned (slice address 0 3))
    (def padding #b00)
    (def app-diff (concat aligned padding app-tag))
    (def app-base #x0000000000010000)
    (def app-differences (::rv64::arithmetic::xor app-diff app-base))
    (def wrong-app (any-bit-64 app-differences))
    (def app (nor wrong-app wrong-app))
    (def status-address #x0000000000200000)
    (def data-address #x0000000000200008)
    (def ack-address #x0000000000200010)
    (def (status less-status) (::rv64::arithmetic::compare-unsigned address status-address))
    (def (data less-data) (::rv64::arithmetic::compare-unsigned address data-address))
    (def (ack less-ack) (::rv64::arithmetic::compare-unsigned address ack-address)))

  (func firmware-data-access (in (address (bits 64))) (out readable writable)
    (def (writable status data ack) (uart-test-map address))
    (def uart-readable (execute-or status data))
    (def readable (execute-or uart-readable writable)))

  (func firmware-full-store-access (in (address (bits 64))) (out writable)
    (def (app status data ack) (uart-test-map address))
    (def writable (execute-or ack app)))

  (func firmware-subword-access (in (address (bits 64))) (out readable writable)
    (def (readable status data ack) (uart-test-map address))
    (def writable readable))

  (func uart-test-read
    (in status data app rx-ready (rx-word (bits 64)) (ram-output (bits 64)))
    (out (read-data (bits 64)))
    (def zero #x0000000000000000)
    (def status-padding (slice zero 1 63))
    (def status-word (concat rx-ready status-padding))
    (def status-response (::rv64::arithmetic::select status zero status-word))
    (def mmio-response (::rv64::arithmetic::select data status-response rx-word))
    (def read-data (::rv64::arithmetic::select app mmio-response ram-output)))

  (module uart-entry-fixture
    (in rx-ready (rx-word (bits 64)) (probe (bits 64)))
    (out (pc (bits 64)) (bus-address (bits 64)) (register-data (bits 64))
         register-enable commit stopped rx-ack write-app (ram-output (bits 64))
         (bus-write-data (bits 64)))
    (def (pc bus-address bus-write-data write register-data register-enable commit stopped)
      (uart-firmware-machine probe read-data))
    (def (app status data ack) (uart-test-map bus-address))
    (def rx-ack (accept-pulse write ack))
    (def write-app (accept-pulse write app))
    (def index (slice bus-address 3 2))
    (def ram-output (uart-entry-ram index bus-write-data write-app))
    (def read-data (uart-test-read status data app rx-ready rx-word ram-output))))
