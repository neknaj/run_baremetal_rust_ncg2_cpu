; PC の補正、命令取得、RISC-V の PC 相対命令の物理アドレス仕様。
(define-fun auipc () Bool (= ((_ extract 6 0) instruction) #b0010111))
(define-fun jal () Bool (= ((_ extract 6 0) instruction) #b1101111))
(define-fun jalr () Bool
  (and (= ((_ extract 6 0) instruction) #b1100111) (= ((_ extract 14 12) instruction) #b000)))
(define-fun imm-u () (_ BitVec 64)
  ((_ sign_extend 32) (concat ((_ extract 31 12) instruction) #x000)))
(define-fun imm-j () (_ BitVec 64)
  ((_ sign_extend 43)
    (concat ((_ extract 31 31) instruction)
      (concat ((_ extract 19 12) instruction)
        (concat ((_ extract 20 20) instruction) (concat ((_ extract 30 21) instruction) #b0))))))
(define-fun imm-i () (_ BitVec 64) ((_ sign_extend 52) ((_ extract 31 20) instruction)))
(define-fun after () (_ BitVec 64) (bvadd pc (_ bv4 64)))
(define-fun target () (_ BitVec 64)
  (ite auipc after (ite jal (bvadd pc imm-j) (bvand (bvadd rs1 imm-i) #xfffffffffffffffe))))
(define-fun expected-valid () Bool (or auipc (= ((_ extract 1 0) target) #b00)))
(define-fun expected-register () (_ BitVec 64) (ite auipc (bvadd pc imm-u) after))
(define-fun expected-fetch () Bool
  (and (bvuge pc #x0000000000010000) (bvult pc #x0000000000052000) (= ((_ extract 1 0) pc) #b00)))
(define-fun expected-instruction () (_ BitVec 32)
  (ite (= ((_ extract 2 2) pc) #b0) ((_ extract 31 0) ram) ((_ extract 63 32) ram)))
(assert
  (or (distinct offset (bvsub pc #x0000000000010000))
      (distinct round-trip pc)
      (distinct fetch-valid expected-fetch)
      (distinct word-address (bvand pc #xfffffffffffffff8))
      (distinct fetched expected-instruction)
      (and (or auipc jal jalr)
        (or (distinct valid expected-valid)
            (distinct write-register expected-valid)
            (distinct next (ite expected-valid target pc))
            (and expected-valid (distinct register expected-register))))))
(check-sat)
